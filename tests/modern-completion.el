;;; modern-completion.el --- Completion migration checks -*- lexical-binding: t; -*-
;; Batch-only runner: exits Emacs after ERT. Do not load in a working session.
;; Load after Doom startup. Failed artifacts remain in /tmp.
(require 'ert)
(require 'cl-lib)
(run-hooks 'doom-first-input-hook)
(doom-init-leader-keys-h)
(require 'org)
(require 'org-id)
(require 'consult)
(require 'recentf)
(require 'consult-org)
(require 'corfu)
(require 'cape)
(require 'orderless)
(require 'vertico-prescient)
(require 'yasnippet)
(defvar zz/modern-test-root (make-temp-file "doom-modern-tests-" t))
(setq org-id-locations-file (expand-file-name "ids" zz/modern-test-root)
      org-id-locations (make-hash-table :test #'equal)
      org-id-files nil org-id-extra-files nil org-agenda-files nil
      desktop-save nil kill-emacs-hook nil)
(message "Modernization artifacts: %s" zz/modern-test-root)

(ert-deftest zz/modern-stack-and-orderless ()
  (should global-corfu-mode)
  (should vertico-mode)
  (should marginalia-mode)
  (should vertico-prescient-mode)
  (should prescient-persist-mode)
  (should-not vertico-prescient-enable-filtering)
  (should-not (bound-and-true-p global-company-mode))
  (should-not (bound-and-true-p ivy-mode))
  (should (eq corfu-preview-current t))
  (should (member "alpha-beta" (orderless-filter "beta alpha" '("alpha-beta" "gamma")))))

(ert-deftest zz/modern-prose-and-code-completion ()
  (dolist (mode '(org-mode markdown-mode emacs-lisp-mode))
    (with-temp-buffer
      (funcall mode)
      (corfu-mode 1)
      (yas-minor-mode 1)
      (should (memq #'yasnippet-capf completion-at-point-functions))
      (if (eq mode 'emacs-lisp-mode)
          (progn
            (should corfu-auto)
            (insert "(mess")
            (let* ((data (elisp-completion-at-point))
                   (prefix (buffer-substring (nth 0 data) (nth 1 data))))
              (should (member "message" (all-completions prefix (nth 2 data))))))
        (should-not corfu-auto)
        (should visual-line-mode)
        (should +word-wrap-mode)
        (should-not auto-fill-function)))))

(ert-deftest zz/modern-prose-completion-after-corfu-activation ()
  (dolist (mode '(org-mode markdown-mode))
    (with-temp-buffer
      (funcall mode)
      ;; Exercise activation with automatic completion initially enabled.
      (setq-local corfu-auto t)
      (corfu-mode 1)
      (should-not corfu-auto)
      (should-not (memq #'corfu-auto--post-command post-command-hook))
      (should corfu-mode)
      (should (eq completion-in-region-function #'corfu--in-region)))))

(ert-deftest zz/modern-keybindings ()
  (should (eq (key-binding (kbd "C-x b")) #'zz/buffer-or-recentf))
  (should (eq (key-binding (kbd "C-x C-b")) #'zz/switch-buffer))
  (should (eq (key-binding (kbd "C-s")) #'+default/search-buffer))
  (should (eq (key-binding (kbd "M-g o")) #'zz/outline))
  (should (memq (key-binding (kbd "C-M-i")) '(completion-at-point complete-symbol)))
  (with-temp-buffer
    (org-mode)
    (should (eq (key-binding (kbd "C-c l l h")) #'zz/org-insert-heading-link))
    (should (eq (key-binding (kbd "C-y")) #'zz/org-smart-yank))
    (should (eq (key-binding (kbd "C-c e")) #'+eval/line-or-region))
    (should (eq (key-binding (kbd "C-c C-e")) #'zz/org-export-menu))
    (require 'transient)
    (should (eq (plist-get (cdr (transient-get-suffix 'zz/org-export-menu "e")) :command)
                #'org-export-dispatch))))

(ert-deftest zz/modern-buffer-sources ()
  (let (seen)
    (cl-letf (((symbol-function 'consult-buffer) (lambda (&optional sources) (setq seen sources))))
      (zz/buffer-or-recentf)
      (should (equal seen '(consult-source-buffer consult-source-recent-file)))
      (zz/switch-buffer)
      (should (equal seen '(consult-source-buffer))))))

(ert-deftest zz/modern-recent-file-deduplication ()
  (let* ((file (expand-file-name ".doom-modern-visited" doom-user-dir))
         (other (expand-file-name "not-open" zz/modern-test-root))
         (recentf-list (list (abbreviate-file-name file) other)))
    (with-temp-buffer
      (rename-buffer "modern-file" t)
      (setq buffer-file-name file)
      (let ((items (funcall (plist-get consult-source-recent-file :items))))
        (should-not (member (abbreviate-file-name file) items))
        (should (member other items))))))

(ert-deftest zz/modern-org-link-readable-id-and-insertion-point ()
  (with-temp-buffer
    (org-mode)
    (setq buffer-file-name (expand-file-name "links.org" zz/modern-test-root))
    (insert "* Target title\nBody.\n* Destination\nInsert here: ")
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt candidates &rest _)
                 (caar candidates))))
      (zz/org-insert-heading-link))
    (should (string-suffix-p "Insert here: [[#target-title][Target title]]" (buffer-string)))
    (goto-char (point-min))
    (should (equal (org-entry-get nil "CUSTOM_ID") "target-title"))))

(ert-deftest zz/modern-org-link-existing-id-duplicates-and-cancel ()
  (with-temp-buffer
    (org-mode)
    (setq buffer-file-name (expand-file-name "duplicates.org" zz/modern-test-root))
    (insert "* Same\n:PROPERTIES:\n:CUSTOM_ID: first\n:END:\n* Same\n:PROPERTIES:\n:CUSTOM_ID: second\n:END:\nLink: ")
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt candidates &rest _)
                 (should (= 2 (length (delete-dups (mapcar #'car candidates)))))
                 (car (nth 1 candidates)))))
      (zz/org-insert-heading-link))
    (should (string-suffix-p "Link: [[#second][Same]]" (buffer-string)))
    (let ((before (buffer-string)))
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
        (condition-case nil (zz/org-insert-heading-link) (quit nil)))
      (should (equal before (buffer-string))))))

(defun zz/modern-capf-candidates (capf)
  "Return candidates from CAPF at point."
  (let ((data (funcall capf)))
    (should data)
    (all-completions (buffer-substring (nth 0 data) (nth 1 data)) (nth 2 data))))

(ert-deftest zz/modern-lua-candidates ()
  (with-temp-buffer
    (lua-mode)
    (insert "math.sq")
    (should (memq #'zz/capf-company-lua completion-at-point-functions))
    (should (seq-some (lambda (s) (string-match-p "sqrt" s))
                      (zz/modern-capf-candidates #'zz/capf-company-lua)))
    (should-not (bound-and-true-p company-mode))))

(ert-deftest zz/modern-latex-candidates ()
  (require 'latex)
  (with-temp-buffer
    (LaTeX-mode)
    (insert "$\\alp $")
    (backward-char 2)
    (font-lock-ensure)
    (should (memq #'zz/capf-company-auctex-macros completion-at-point-functions))
    (should (seq-some (lambda (s) (string-match-p "alpha" s))
                      (zz/modern-capf-candidates #'zz/capf-+latex-symbols-company-backend)))
    (should reftex-mode)
    (should (memq #'zz/capf-company-reftex-labels completion-at-point-functions))
    (should-not (bound-and-true-p company-mode))))

(ert-deftest zz/modern-native-language-capfs ()
  (require 'sly)
  (sly-setup)
  (dolist (entry '((lisp-mode . sly-complete-symbol)
                   (python-mode . python-completion-at-point)
                   (ess-r-mode . ess-r-object-completion)))
    (with-temp-buffer
      (funcall (car entry))
      (when (eq (car entry) 'lisp-mode)
        (run-hooks 'lisp-mode-local-vars-hook))
      (should (memq (cdr entry) completion-at-point-functions))))
  (require 'corfu-terminal)
  (require 'consult-lsp)
  (should (commandp 'consult-lsp-symbols)))

(let ((noninteractive t))
  (ert-run-tests-batch-and-exit "^zz/modern-"))
