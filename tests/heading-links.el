;;; heading-links.el --- Batch-only heading link regression tests -*- lexical-binding: t; -*-
;; Requires Org, ox-hugo and Hugo on the load path/PATH.
(require 'ert)
(require 'org)
(require 'org-archive)
(require 'ox-hugo)
(require 'json)
(defmacro after! (_ &rest body) `(progn ,@body))
;; Load only these helpers from the authoritative literate source.
(with-temp-buffer
  (insert-file-contents (expand-file-name "../doom.org" (file-name-directory load-file-name)))
  (goto-char (point-min))
  (search-forward "(defun zz/make-id-for-title")
  (beginning-of-line)
  (let ((start (point)))
    (search-forward "\n#+end_src")
    (eval-region start (match-beginning 0))))
(setq enable-local-variables nil enable-local-eval nil org-export-use-babel nil)
(defvar zz/test-dir (make-temp-file "zz-link-export-test-" t))
(setq org-id-locations-file (expand-file-name "ids" zz/test-dir))
(defun zz/test-release (items)
 (dolist (item items) (when (nth 2 item) (set-marker (nth 2 item) nil))))
(ert-deftest included-link-full-export ()
 (let* ((default-directory (file-name-as-directory zz/test-dir))
        (include (expand-file-name "include.org"))
        (main (expand-file-name "main.org")))
  (make-directory "content" t)
  (with-temp-file include (insert "* Organization and Productivity\nText.\n* Other applications\n:PROPERTIES:\n:CUSTOM_ID: explicit-apps\n:END:\nText.\n"))
  (with-temp-file main
   (insert (format "#+hugo_base_dir: %s\n" zz/test-dir)
           "* Home\n:PROPERTIES:\n:EXPORT_HUGO_SECTION: /\n:EXPORT_FILE_NAME: _index\n:END:\nWelcome.\n"
           "* Source\n:PROPERTIES:\n:EXPORT_HUGO_SECTION: post\n:EXPORT_FILE_NAME: source\n:END:\n[[https://old.example/][Keep *my* description]]\n"
           "* Target\n:PROPERTIES:\n:EXPORT_HUGO_SECTION: post\n:EXPORT_HUGO_BUNDLE: target\n:EXPORT_FILE_NAME: index\n:END:\n#+include: \"include.org\"\n"))
  (find-file main)
  (let* ((items (zz/org-heading-link-candidates))
         (choice (seq-find (lambda (x) (equal (nth 1 x) "Organization and Productivity")) items))
         (explicit (seq-find (lambda (x) (equal (nth 1 x) "Other applications")) items)))
   (should (equal (nth 3 choice) "hugo-ref:/post/target/index.md#organization-and-productivity"))
   (should (equal (nth 3 explicit) "hugo-ref:/post/target/index.md#explicit-apps"))
   (goto-char (point-min)) (search-forward "Keep")
   (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (car choice))))
    (zz/org-insert-heading-link t))
   (should (string-match-p (regexp-quote "[[hugo-ref:/post/target/index.md#organization-and-productivity][Keep *my* description]]") (buffer-string)))
   (save-buffer)
   (org-hugo-export-wim-to-md :all)
   (zz/test-release items))
  (with-temp-buffer
   (insert-file-contents "content/post/source.md")
   (should (search-forward "relref \"/post/target/index.md#organization-and-productivity\"" nil t)))
  (make-directory "layouts/_default" t)
  (with-temp-file "layouts/_default/single.html" (insert "{{ .Content }}"))
  (with-temp-file "layouts/_default/list.html" (insert "{{ .Content }}"))
  (with-temp-file "hugo.toml" (insert "baseURL='https://example.org/'\n[permalinks]\npost='/post/:slug'\n"))
  (should (= 0 (call-process "hugo" nil "*zz-hugo-test*" nil "--source" zz/test-dir)))
  (with-temp-buffer
   (insert-file-contents "public/post/source/index.html")
   (should (search-forward "href=\"/post/target/#organization-and-productivity\"" nil t))
   (should (search-forward "Keep <strong>my</strong> description" nil t)))
  (kill-buffer (find-buffer-visiting main))))
(ert-deftest replace-local-link-and-plain-url ()
 (dolist (old '("[[https://old/][My *text*]]" "[[https://old/]]"))
  (with-temp-buffer
   (org-mode) (insert "* Target\n:PROPERTIES:\n:CUSTOM_ID: target\n:END:\n" old "  trailing\n")
   (goto-char (point-min)) (search-forward "https://")
   (cl-letf (((symbol-function 'completing-read) (lambda (_ choices &rest _) (caar choices))))
    (zz/org-insert-heading-link t))
   (should (string-match-p (regexp-quote (if (string-match-p "My" old) "[[#target][My *text*]]  trailing" "[[#target][https://old/]]  trailing")) (buffer-string))))))
(ert-deftest replace-requires-link ()
 (with-temp-buffer (org-mode) (insert "* Heading\nText")
  (should-error (zz/org-insert-heading-link t) :type 'user-error)))
(ert-deftest real-site-owner ()
 (with-temp-buffer
  (insert-file-contents "/var/home/diego/Dropbox/Personal/websites/zzamboni.org/content-org/zzamboni.org")
  (setq buffer-file-name "/var/home/diego/Dropbox/Personal/websites/zzamboni.org/content-org/zzamboni.org" default-directory (file-name-directory buffer-file-name))
  (org-mode)
  (let* ((items (zz/org-heading-link-candidates))
         (entry (seq-find (lambda (x) (and (equal (nth 1 x) "Organization and Productivity") (nth 3 x))) items)))
   (should (equal (nth 3 entry) "hugo-ref:/post/2018-01-08-my-hammerspoon-configuration-with-commentary.md#organization-and-productivity"))
   (zz/test-release items))))
(message "Test artifacts: %s" zz/test-dir)
(ert-run-tests-batch-and-exit)
